<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>

        <TargetFrameworks>net10.0-windows</TargetFrameworks>
        <!-- <TargetFrameworks>net10.0-windows10.0.22621.0</TargetFrameworks> -->
        <!-- <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework> -->

        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <NoWarn>$(NoWarn);CA1001</NoWarn>

        <OutputType>WinExe</OutputType>
        <UseWindowsForms>true</UseWindowsForms>
        
        <AppDesignerFolder>Properties</AppDesignerFolder>
        <RootNamespace>AudioLab</RootNamespace>
        <AssemblyName>AudioLab</AssemblyName>
        <Title>NAudioDemo</Title>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
    </PropertyGroup>


    <ItemGroup>
        <PackageReference Include="NAudio" Version="3.1.0" />
        <!-- <PackageReference Include="NAudio.Extras" Version="3.1.0" /> -->
    </ItemGroup>

</Project>