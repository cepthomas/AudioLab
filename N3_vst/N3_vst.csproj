<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0-windows</TargetFrameworks>
        <!-- <TargetFrameworks>net10.0-windows10.0.22621.0</TargetFrameworks> -->
        <!-- <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework> -->

        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <NoWarn>$(NoWarn);CA1001</NoWarn>

        <OutputType>Library</OutputType>
        <UseWindowsForms>true</UseWindowsForms>
        
        <AppDesignerFolder>Properties</AppDesignerFolder>
        <RootNamespace>N3_vst</RootNamespace>
        <AssemblyName>N3_vst</AssemblyName>
        <!-- <Title>NAudioDemo</Title> -->
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NAudio" Version="3.1.0" />
        <!-- TODO??? <PackageReference Include="NAudio.Extras" Version="3.1.0" /> -->
        <PackageReference Include="NAudio.Extras" Version="3.1.0" />

        <PackageReference Include="NAudio.Vst3" Version="3.1.0" />
        <!-- <PackageReference Include="NAudio.Sampler" Version="3.1.0" /> -->

    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\N3_common\N3_common.csproj" />
    </ItemGroup>


    <ItemGroup>
      <Reference Include="Ephemera.MidiLib">
        <HintPath>..\lib\Ephemera.MidiLib.dll</HintPath>
      </Reference>
      <Reference Include="Ephemera.NBagOfTricks">
        <HintPath>..\lib\Ephemera.NBagOfTricks.dll</HintPath>
      </Reference>
      <Reference Include="Ephemera.NBagOfUis">
        <HintPath>..\lib\Ephemera.NBagOfUis.dll</HintPath>
      </Reference>
    </ItemGroup>

</Project>